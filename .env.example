# Example environment variables for local development.
# Do NOT commit real keys to version control. Copy this file to '.env' or configure
# through app config before running the app.

# TMDB API key (v3). Create at https://www.themoviedb.org -> Settings -> API
TMDB_API_KEY=your_tmdb_api_key_here

# MongoDB connection string (for backend authentication and user data)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/databasename

# JWT secret for token signing (use a strong, random string)
JWT_SECRET=your_jwt_secret_here
